# ==============================================================
# HIREWORK Freelance Marketplace - Backend Environment Config
# ==============================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# Database Connection (MongoDB URI)
# In production, use MongoDB Atlas or secured replica set URI
MONGO_URI=mongodb://127.0.0.1:27017/HIREWORK
EXIT_ON_DB_FAILURE=false

# JSON Web Token Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# Client URL (Allowed CORS Origin for frontend)
CLIENT_URL=http://localhost:5173

# Real-Time WebSockets
ENABLE_SOCKET_IO=true

# --- Optional External Services ---

# SMTP Email Configuration (for password reset, OTP, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# Google OAuth2 Credentials (for Social Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Razorpay Payment Gateway (for escrow and milestone payouts)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Storage (for project attachments, deliverables & avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@hirework.in
