# ==============================================================
# HIREWORK Freelance Marketplace - Frontend Environment Config
# ==============================================================

# Backend API Base URL (leave empty or set if backend is on another origin)
VITE_API_URL=http://localhost:5000

# Google OAuth Client ID (for Google Sign-In)
# https://console.cloud.google.com -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Web Push Notification Public VAPID Key (must match backend VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
